# backend/.env.example
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/dbname
POSTGRESQL_DB_NAME=your_db_name
POSTGRESQL_USER=your_db_user
POSTGRESSQL_PASSWORD=your_db_password
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432

# Redis (for Channels)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_SMS_NUMBER=+1234567890
TWILIO_VOICE_NUMBER=+1234567890

# ElevenLabs
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key-here

# AWS S3 (for storing audio files) - Optional
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Application URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Webhook URL (for testing with ngrok or similar service)
WEBHOOK_BASE_URL=https://your-webhook-url.ngrok-free.app
